hr { color: #000000}
body, table
{
 font-size: 10pt;
 font-family: 'Arial';
 font-style: normal;
 font-weight: normal;
 color: #000000;
 text-decoration: none;
}
table.ftable {
  border-collapse: collapse;
  border: 1px solid #000000;
 }
table.ftable td, table.ftable th {
  border: 1px solid #000000;
}

table.ptable {
  border-collapse: collapse;
  border: 0px solid;
 }
table.ptable td{
  border: 0px solid;
}
